{
  "name": "projectmatch-blockchain",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "^22.10.0 || ^24.0.0" },
  "scripts": {
    "hardhat": "node --require ./scripts/hardhat-env.js ./node_modules/hardhat/internal/cli/bootstrap.js",
    "compile": "npm run hardhat -- compile",
    "test": "npm run hardhat -- test",
    "node": "npm run hardhat -- node --hostname 127.0.0.1 --port 8545",
    "deploy": "npm run compile && node --env-file-if-exists=.env --require ./scripts/hardhat-env.js scripts/deploy.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "demo:study": "npm run compile && node --env-file-if-exists=.env --require ./scripts/hardhat-env.js scripts/study.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "solc": "0.8.24"
  }
}
